APP_NAME="financi.ai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
ASSET_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

ALLOW_REGISTRATION=true
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=db
DB_PORT=5432
DB_DATABASE=meu_financeiro
DB_USERNAME=financeiro
DB_PASSWORD=financeiro_local
DB_SCHEMA=finance
DB_SSLMODE=disable
DB_POOL_MODE=session

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="nao-responda@financi.ai"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail: altere MAIL_MAILER para smtp, use o e-mail completo como usuário
# e uma senha de app (nunca a senha normal da conta).
# Produção: prefira um provedor transacional como Postmark ou Resend.
# A recuperação de senha e a verificação de e-mail dependem de um mailer real.

LARAVEL_STORAGE_PATH=
VIEW_COMPILED_PATH=
APP_CONFIG_CACHE=
APP_EVENTS_CACHE=
APP_PACKAGES_CACHE=
APP_ROUTES_CACHE=
APP_SERVICES_CACHE=

VITE_APP_NAME="${APP_NAME}"
