APP_NAME="financi.ai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
ASSET_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

ALLOW_REGISTRATION=true
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=db
DB_PORT=5432
DB_DATABASE=meu_financeiro
DB_USERNAME=financeiro
DB_PASSWORD=financeiro_local
DB_SCHEMA=finance
DB_SSLMODE=disable
DB_POOL_MODE=session

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LARAVEL_STORAGE_PATH=
VIEW_COMPILED_PATH=
APP_CONFIG_CACHE=
APP_EVENTS_CACHE=
APP_PACKAGES_CACHE=
APP_ROUTES_CACHE=
APP_SERVICES_CACHE=

VITE_APP_NAME="${APP_NAME}"
